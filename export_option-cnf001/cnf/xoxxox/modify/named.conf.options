options {
  directory "/var/cache/bind";
  listen-on { 127.0.0.1; 192.168.100.10; };
  listen-on-v6 { none; };
  recursion yes;
  allow-query { any; };
  dnssec-validation no;
};

logging {
  channel default_log {
    file "/var/log/bind/named.log" versions 3 size 1m;
    severity info;
    print-time yes;
    print-category yes;
  };
  category default { default_log; };
  category queries { default_log; };
};
